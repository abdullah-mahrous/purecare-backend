{
  "name": "PureCare-backend",
  "version": "1.0.0",
  "description": "PureCare Backend powers the website's dynamic content and provides centralized control over the platform allowing authorized administrators to manage website content, healthcare services, medical equipment rentals, reservations careers applications, and customer inquiries without requiring frontend code changes.",
  "homepage": "https://github.com/abdullah-mahrous/purecare-frontend#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullah-mahrous/purecare-backend.git"
  },
  "license": "ISC",
  "author": "Abdullah-Mahrous",
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
